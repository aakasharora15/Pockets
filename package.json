{
  "name": "spendr",
  "private": true,
  "version": "1.1.0",
  "description": "Open-source expense tracker for you and the people you share costs with.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:emulators": "VITE_EMULATORS=1 vite",
    "emulators": "firebase emulators:start --only auth,firestore --project demo-spendr",
    "seed": "node scripts/seed-emulator.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run src",
    "test:rules": "firebase emulators:exec --only firestore --project demo-spendr \"vitest run tests/rules\"",
    "deploy": "npm run build && firebase deploy --only hosting,firestore",
    "predev": "node scripts/copy-ocr.mjs",
    "predev:emulators": "node scripts/copy-ocr.mjs",
    "prebuild": "node scripts/copy-ocr.mjs"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "firebase": "^13.0.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.2",
    "firebase-tools": "^15.33.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3"
  }
}
