rules_version = '2';

// Spendr security rules.
//
// Model: a user can read and write a Pocket and everything under it only if they have a
// document in pockets/{pocketId}/members/{uid}. Personal Pockets have exactly one member.
// Joining a shared Pocket happens in one batch that marks an invite used and creates the
// member document; the rules below check that pair, so no Cloud Function is needed and the
// app runs on Firebase's free plan.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------

    function signedIn() {
      return request.auth != null;
    }
    function me() {
      return request.auth.uid;
    }
    function memberPath(pid, uid) {
      return /databases/$(database)/documents/pockets/$(pid)/members/$(uid);
    }
    function pocketPath(pid) {
      return /databases/$(database)/documents/pockets/$(pid);
    }
    function invitePath(code) {
      return /databases/$(database)/documents/invites/$(code);
    }
    // Membership as it stands now (reads) and after this request (writes in a batch).
    function isMember(pid) {
      return signedIn() && exists(memberPath(pid, me()));
    }
    function isMemberAfter(pid) {
      return signedIn() && existsAfter(memberPath(pid, me()));
    }
    function isOwner(pid) {
      return isMember(pid) && get(pocketPath(pid)).data.ownerUid == me();
    }
    function changes() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }
    function isText(v, maxLen) {
      return v is string && v.size() <= maxLen;
    }
    function isName(v) {
      return v is string && v.size() > 0 && v.size() <= 60;
    }
    function isInitials(v) {
      return v is string && v.size() > 0 && v.size() <= 4;
    }
    function currencyCodes() {
      return ['GBP', 'INR', 'USD', 'EUR', 'AUD', 'CAD', 'SGD', 'NZD'];
    }

    // ---------- users ----------

    match /users/{uid} {
      allow read, delete: if signedIn() && me() == uid;
      allow create, update: if signedIn() && me() == uid
        && request.resource.data.keys().hasOnly(['name', 'initials', 'email', 'createdAt', 'pocketIds'])
        && isName(request.resource.data.name)
        && isInitials(request.resource.data.initials)
        && request.resource.data.pocketIds is list;
    }

    // ---------- pockets ----------

    function validPocket(d) {
      return d.keys().hasOnly(['name', 'type', 'ownerUid', 'currencies', 'budgets', 'createdAt'])
        && isName(d.name)
        && d.type in ['personal', 'shared']
        && d.currencies is list && d.currencies.size() > 0 && d.currencies.size() <= 8
        && d.currencies.toSet().difference(currencyCodes().toSet()).size() == 0
        && d.budgets is map
        && d.budgets.keys().toSet().difference(currencyCodes().toSet()).size() == 0;
    }

    match /pockets/{pid} {
      allow read: if isMember(pid);

      // Created in the same batch as the owner's member document.
      allow create: if signedIn()
        && validPocket(request.resource.data)
        && request.resource.data.ownerUid == me()
        && (request.resource.data.type == 'shared' || pid == 'personal_' + me())
        && existsAfter(memberPath(pid, me()));

      allow update: if validPocket(request.resource.data)
        && request.resource.data.type == resource.data.type
        && (
          // Anyone in the Pocket can set budgets.
          (isMember(pid) && changes().hasOnly(['budgets']))
          // Only the owner can rename, change currencies or hand over ownership.
          || (isOwner(pid)
              && (request.resource.data.ownerUid == me()
                  || (resource.data.type == 'shared'
                      && exists(memberPath(pid, request.resource.data.ownerUid)))))
        );

      allow delete: if isOwner(pid);

      // ---------- members ----------

      function validMember(d, uid) {
        return d.keys().hasOnly(['uid', 'name', 'initials', 'role', 'joinedAt', 'inviteCode'])
          && d.uid == uid
          && isName(d.name)
          && isInitials(d.initials)
          && d.role in ['owner', 'member'];
      }

      match /members/{uid} {
        allow read: if isMember(pid);

        allow create: if signedIn() && uid == me()
          && validMember(request.resource.data, uid)
          && (
            // Founder: the Pocket is being created in this batch with me as owner.
            (request.resource.data.role == 'owner'
              && !exists(pocketPath(pid))
              && getAfter(pocketPath(pid)).data.ownerUid == me())
            // Joiner: redeeming an unused, unexpired invite for this shared Pocket in this batch.
            || (request.resource.data.role == 'member'
              && request.resource.data.inviteCode is string
              && get(invitePath(request.resource.data.inviteCode)).data.pocketId == pid
              && get(invitePath(request.resource.data.inviteCode)).data.usedByUid == null
              && request.time < get(invitePath(request.resource.data.inviteCode)).data.createdAt + duration.value(48, 'h')
              && getAfter(invitePath(request.resource.data.inviteCode)).data.usedByUid == me()
              && get(pocketPath(pid)).data.type == 'shared')
          );

        allow update: if validMember(request.resource.data, uid) && (
          // Change your own name and initials.
          (uid == me() && isMember(pid) && changes().hasOnly(['name', 'initials']))
          // The owner hands over ownership.
          || (isOwner(pid) && changes().hasOnly(['role']))
        );

        // Owner removes someone; anyone leaves (the owner only once the Pocket is gone or handed over).
        allow delete: if signedIn() && (
          (uid != me() && isOwner(pid))
          || (uid == me()
              && (!existsAfter(pocketPath(pid)) || getAfter(pocketPath(pid)).data.ownerUid != me()))
        );
      }

      // ---------- categories ----------

      function validCategory(d) {
        return d.keys().hasOnly(['name', 'icon', 'colour', 'order', 'system'])
          && isName(d.name)
          && isText(d.icon, 40)
          && isText(d.colour, 9)
          && d.order is number
          && d.system is bool;
      }

      match /categories/{cid} {
        allow read: if isMember(pid);
        allow create: if isMemberAfter(pid) && validCategory(request.resource.data)
          && request.resource.data.system == (cid == 'other');
        allow update: if isMember(pid) && validCategory(request.resource.data)
          && request.resource.data.system == resource.data.system;
        // "Other" can't be deleted, except when the whole Pocket is going.
        allow delete: if isMember(pid) && (cid != 'other' || isOwner(pid));
      }

      // ---------- expenses ----------

      function validExpense(d) {
        return d.keys().hasOnly(['currency', 'amountMinor', 'name', 'categoryId', 'byUid', 'byInitials',
                                 'editedByUid', 'date', 'note', 'createdAt', 'updatedAt'])
          && d.currency in currencyCodes()
          && d.amountMinor is int && d.amountMinor > 0 && d.amountMinor < 1000000000
          && isText(d.name, 100)
          && isText(d.categoryId, 40)
          && d.byUid is string
          && isInitials(d.byInitials)
          && (!('editedByUid' in d) || d.editedByUid is string)
          && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && (!('note' in d) || isText(d.note, 500));
      }

      match /expenses/{eid} {
        allow read: if isMember(pid);
        allow create, update: if isMemberAfter(pid) && validExpense(request.resource.data);
        allow delete: if isMember(pid);
      }
    }

    // ---------- members across Pockets (to list "my Pockets") ----------

    match /{path=**}/members/{uid} {
      allow list: if signedIn() && resource.data.uid == me();
    }

    // ---------- invites ----------

    match /invites/{code} {
      // Codes are random and unguessable; any signed-in user holding one can preview it.
      allow get: if signedIn();
      // People screen lists a Pocket's pending invites.
      allow list: if isMember(resource.data.pocketId);

      allow create: if isMember(request.resource.data.pocketId)
        && code.matches('^[A-HJ-NP-Z2-9]{6}$')
        && request.resource.data.keys().hasOnly(['code', 'pocketId', 'pocketName', 'createdByUid', 'createdByName',
                                                  'createdAt', 'expiresAt', 'usedByUid', 'members', 'currencies'])
        && request.resource.data.code == code
        && request.resource.data.createdByUid == me()
        && request.resource.data.usedByUid == null
        // The server's clock decides expiry: 48 hours after createdAt. expiresAt is for display.
        && request.resource.data.createdAt == request.time
        && request.resource.data.expiresAt is timestamp
        && get(pocketPath(request.resource.data.pocketId)).data.type == 'shared';

      // Redeem: single use, before expiry, by the caller, together with creating their membership.
      allow update: if signedIn()
        && resource.data.usedByUid == null
        && request.time < resource.data.createdAt + duration.value(48, 'h')
        && changes().hasOnly(['usedByUid', 'usedAt'])
        && request.resource.data.usedByUid == me()
        && existsAfter(memberPath(resource.data.pocketId, me()));

      // Cancel a pending invite (or clean up when the Pocket is deleted).
      allow delete: if isMember(resource.data.pocketId);
    }
  }
}
